# Server environment only. Never put keys in Android source, BuildConfig, or APK.
# Copy to .env and launch through scripts/start-api.ps1, or set shell variables.
# Uvicorn --env-file .env explicitly loads the file; application imports do not.
OPENAI_API_KEY=
OPENAI_MODEL=
KAKAO_REST_API_KEY=
KAKAO_MOBILITY_REST_API_KEY=
