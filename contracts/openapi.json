          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/demo": {
      "get": {
        "summary": "Demo",
        "operationId": "demo_v1_demo_get",
        "parameters": [
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "basic",
                "deadline_conflict"
              ],
              "type": "string",
              "default": "basic",
              "title": "Scenario"
            }
